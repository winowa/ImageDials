# Copy to .env in the repository root. Both launchers read this same file.
# Values are parsed as dotenv data, never executed as shell code.
# Use literal values, not shell expressions or variable interpolation.
FRONTEND_PORT=5173
API_PORT=8000
# Seconds to drain API HTTP connections, including event streams, during shutdown.
API_SHUTDOWN_GRACE_SECONDS=10

# Bind to loopback by default. Override only for your intended deployment.
FRONTEND_HOST=127.0.0.1
API_HOST=127.0.0.1

# Hostnames accepted by the frontend. Comma-separated, no schemes or ports.
# Add your named reverse-proxy hostname when deploying; never use an allow-all value.
FRONTEND_ALLOWED_HOSTS=localhost

# Base URL of the API as seen by the frontend server, not the browser.
# Set to match API_HOST and API_PORT.
API_UPSTREAM_URL=http://127.0.0.1:8000

# Optional Node executable override. Empty uses the Node running the launcher.
# Use an absolute executable path when a service manager has a different PATH.
NODE_BIN=

# Optional Python executable override. Empty uses backend/.venv, with the correct
# Scripts/python.exe (Windows) or bin/python (macOS/Linux) path automatically.
API_PYTHON=

# Backend-only provider base URLs. Slot 1 is primary; slot 2 is optional.
# Empty endpoints leave that provider slot unconfigured. No automatic fallback
# is implied; provider adapters must explicitly support the configured API.
IMAGE_MODEL_ENDPOINT_1=
IMAGE_MODEL_ENDPOINT_2=
LLM_MODEL_ENDPOINT_1=
LLM_MODEL_ENDPOINT_2=

# Optional provider API credentials, paired with the corresponding endpoint.
# Leave blank for services that do not require authentication. Never expose
# these settings through frontend-prefixed variables or browser responses.
IMAGE_MODEL_KEY_1=
IMAGE_MODEL_KEY_2=
LLM_MODEL_KEY_1=
LLM_MODEL_KEY_2=

# Required durable backend data directory; relative paths resolve from backend/.
# Keep generated data in an ignored directory and back it up separately.
IMAGEDIALS_DATA_DIR=../.local/data

# Image adapter: mock produces labelled test artwork; comfyui uses an API workflow.
IMAGE_PROVIDER=mock
# Backend-only path to a ComfyUI API-format node map (not a UI canvas export).
# Exact string values $prompt, $width, $height and $seed are replaced per request.
IMAGE_WORKFLOW_PATH=
# Optional Qwen Image 2.1 ComfyUI editing graph with the reference-input marker.
# Leave blank to disable native reference editing; text generation is unchanged.
IMAGE_EDIT_WORKFLOW_PATH=
# Reference prompting rules; currently only qwen-image-2.1 is supported.
IMAGE_EDIT_PROMPT_STRATEGY=qwen-image-2.1
# Optional lower cap on ordered reference images per edit. Blank uses the
# selected model's documented maximum (Qwen-Image-2.1: 10). Values above that
# maximum, zero or non-numbers fail at startup.
IMAGE_EDIT_MAX_REFERENCES=
# Optional separate endpoint for reference edits, using the same adapter and
# editing workflow. Blank sends edits to IMAGE_MODEL_ENDPOINT_1. The generation
# key is never sent here; IMAGE_EDIT_MODEL_KEY is sent only to this endpoint.
IMAGE_EDIT_MODEL_ENDPOINT=
IMAGE_EDIT_MODEL_KEY=
# Actual model identity recorded with each saved result.
IMAGE_MODEL_NAME=mock-geometric-v1
# Optional LLM model ID; empty discovers the first model from the configured API.
LLM_MODEL_NAME=
# Optional public publisher/detail/resource URLs keyed by the exact model name; never credentials.
MODEL_METADATA_JSON={}
# Maximum wait for a ComfyUI job; expiration does not interrupt the shared worker.
GENERATION_TIMEOUT_SECONDS=600

# Inference gates apply to canonical actions; discovery/static controls remain available.
INFERENCE_ENABLED=true
# Shared storage capabilities; false selects browser-private history/gallery.
SHARED_LIBRARY_ENABLED=true
# Deployment labels and optional canonical API aliases below a path prefix.
APP_ENVIRONMENT=local
EXPERIENCE_PROFILE=public
APP_BASE_PATH=
# Event names are presentation filters, never an authorization boundary.
ACTIVE_EVENT_NAME=
GALLERY_EVENT_NAMES=[]
# Advertised implemented local export actions. External integrations stay disabled.
DOWNLOAD_ENABLED=true
BROWSER_PRINT_ENABLED=true
# Provider-supported requested output dimensions in pixels, exposed in model discovery.
IMAGE_LANDSCAPE_DIMENSIONS=1152x768
IMAGE_PORTRAIT_DIMENSIONS=768x1152
IMAGE_SQUARE_DIMENSIONS=1024x1024

# Maximum decoded pixels for model references and generated originals.
IMAGE_MAX_DECODED_PIXELS=32000000
# Absolute original-upload decode envelope for adaptation/import analysis; at least
# IMAGE_MAX_DECODED_PIXELS and below Pillow's decompression-bomb error threshold.
IMAGE_MAX_SOURCE_PIXELS=120000000
# Maximum imported file bytes; multipart requests have an additional 1 MiB allowance.
IMPORT_MAX_BYTES=33554432
# Server thumbnail derivative cache; bytes and entry count are independent limits.
THUMBNAIL_CACHE_MAX_BYTES=268435456
THUMBNAIL_CACHE_MAX_ENTRIES=4096
# Image description uses a separate adapter. Mock must be explicitly selected.
IMAGE_DESCRIPTION_PROVIDER=openai-compatible
# Empty description settings reuse the primary LLM slot; image input must be supported.
DESCRIPTION_MODEL_ENDPOINT=
DESCRIPTION_MODEL_KEY=
DESCRIPTION_MODEL_NAME=
# Initial browser-local watermark text; blank uses current server watermark defaults.
WATERMARK_DEFAULT_TEXT=
# Longest image edge in pixels sent to the description provider after local resizing.
DESCRIPTION_MAX_EDGE_PIXELS=1280

# Browser cache budgets. All counts and byte limits must be positive integers.
# Shared variants and private originals each default to 500 MiB.
CACHE_SHARED_RECORD_LIMIT=3000
# Full-detail JSON: up to 64 records and 16 MiB, separate from image bytes.
CACHE_SHARED_DETAIL_RECORD_LIMIT=64
CACHE_SHARED_DETAIL_MAX_BYTES=16777216
# Bounded page-manifest/summary metadata: up to 64 manifests and 8 MiB.
CACHE_SHARED_PAGE_MANIFEST_LIMIT=64
CACHE_SHARED_PAGE_MAX_BYTES=8388608
CACHE_SHARED_VARIANT_LIMIT=3000
CACHE_SHARED_VARIANT_MAX_BYTES=524288000
# Explicitly retained reference originals, independent of generated-image history.
CACHE_REFERENCE_RECORD_LIMIT=32
CACHE_REFERENCE_MAX_BYTES=268435456
CACHE_PRIVATE_RECORD_LIMIT=40
CACHE_PRIVATE_MAX_BYTES=524288000
# Capacity for unsaved browser-private images: count and encoded bytes.
CACHE_PRIVATE_VOLATILE_RECORD_LIMIT=8
CACHE_PRIVATE_VOLATILE_MAX_BYTES=268435456
# Prompt/control matching and background requests; durations are milliseconds.
CONTROLS_DEBOUNCE_MS=900
CONTROLS_RESET_DEBOUNCE_MS=250
CONTROLS_REVEAL_HOLD_MS=2000
# Preserve a prompt only above this similarity ratio; equality resets (default: 50% change).
CONTROLS_SIMILARITY_MINIMUM_RATIO=0.5
CONTROLS_MAX_ATTEMPTS=2
# Browser job/library recovery; durations are milliseconds.
JOB_POLL_INTERVAL_MS=1000
JOB_POLL_MAX_FAILURES=5
LIBRARY_RECONNECT_INITIAL_MS=1000
LIBRARY_RECONNECT_MAX_MS=30000
LIBRARY_CHANGE_DEBOUNCE_MS=150
GALLERY_POLL_INTERVAL_MS=5000
LIBRARY_POLL_INTERVAL_MS=10000
LIBRARY_POINTER_IDLE_MS=2500
# Gallery playback hold duration in milliseconds and filmstrip batch sizes.
GALLERY_NEW_IMAGE_HOLD_MS=20000
GALLERY_FILMSTRIP_INITIAL_COUNT=36
GALLERY_FILMSTRIP_BATCH_COUNT=24
# Server shuffle sessions: concurrent count, records per session, renewable lease seconds.
GALLERY_SESSION_MAX_COUNT=4
GALLERY_SESSION_MAX_RECORDS=250000
GALLERY_SESSION_TTL_SECONDS=1800
# Maximum scoped candidate identities in one shared watermark analysis batch.
WATERMARK_BATCH_MAX_RECORDS=250000

# Transient watermark analysis upload bytes; no shared image or sidecar is saved.
WATERMARK_ANALYSIS_MAX_BYTES=33554432
