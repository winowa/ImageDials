# Copy to .env in the repository root. Both launchers read this same file.
# Values are parsed as dotenv data, never executed as shell code.
# Use literal values, not shell expressions or variable interpolation.
FRONTEND_PORT=5173
API_PORT=8000

# Bind to loopback by default. Override only for your intended deployment.
FRONTEND_HOST=127.0.0.1
API_HOST=127.0.0.1

# Hostnames accepted by the frontend. Comma-separated, no schemes or ports.
# Add your named reverse-proxy hostname when deploying; never use an allow-all value.
FRONTEND_ALLOWED_HOSTS=localhost

# Base URL of the API as seen by the frontend server, not the browser.
# Set to match API_HOST and API_PORT.
API_UPSTREAM_URL=http://127.0.0.1:8000

# Optional Node executable override. Empty uses the Node running the launcher.
# Use an absolute executable path when a service manager has a different PATH.
NODE_BIN=

# Optional Python executable override. Empty uses backend/.venv, with the correct
# Scripts/python.exe (Windows) or bin/python (macOS/Linux) path automatically.
API_PYTHON=
