{
  "fixture_kind": "Sanitized contract for optional Standard category suggestions. Offline fixtures and the deterministic mock provider only; not real model output, quality or latency.",
  "contract": {
    "response_field": "standard_selections",
    "placement": "top level of the existing POST /api/controls/dynamic response, beside controls and dynamic_controls_metadata",
    "present_only_when": "at least one category has a usable suggestion (a valid null or empty list counts)",
    "value_shapes": {
      "single/select category": "one option id string, or null",
      "multi/checkbox category": "array of option ids (at most 2, unique), [] for a deliberate empty choice, or null",
      "null": "let the composer decide; consumer sets enabled=false (apply_to_generation=false) and keeps the stored value",
      "absent key": "no usable suggestion; consumer applies its normal fallback"
    },
    "max_multi_suggestions": 2,
    "validation_report": "dynamic_controls_metadata.suggestion_validation (diagnostic only)",
    "evidence_anchor": "dynamic_controls_metadata.suggestion_anchor (16 hex characters)"
  },
  "cases": [
    {
      "name": "valid-mixed",
      "mode": "image",
      "model_field": {
        "style": ["photography", "cinematic"],
        "color": ["warm"],
        "lighting": ["golden-hour"],
        "composition": ["rule-of-thirds"],
        "camera-angle": "low-angle",
        "texture": null,
        "mood": [],
        "background": "outdoors"
      },
