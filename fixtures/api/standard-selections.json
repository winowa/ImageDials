        "status": "valid",
        "accepted": {
          "style": "value",
          "color": "value",
          "lighting": "value",
          "composition": "value",
          "camera-angle": "value",
          "texture": "model-decides",
          "mood": "empty",
          "background": "value"
        },
        "rejected": []
      }
    },
